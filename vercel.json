{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    { "path": "/api/crawl", "schedule": "0 5 * * *" },
    { "path": "/api/digest", "schedule": "0 6 * * *" }
  ]
}
