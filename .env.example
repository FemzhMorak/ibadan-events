PORT=3000

# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Set to true to crawl allevents.in once immediately on server start,
# in addition to the every-6-hours schedule.
CRAWL_ON_START=false

# No TZ variable needed — "today"/"this week" and the cron schedule are
# pinned to Africa/Lagos directly in code (server/lib/time.js and
# server/scheduler.js), since some hosts (Vercel) reserve the TZ name.
